# Plantilla pública. No contiene secretos reales. No sobrescribas tu .env.
DATABASE_URL=
# POSTGRES_URL= es una alternativa; DATABASE_URL tiene prioridad.
SECRET_KEY=
AQUAMONITOR_PAIRING_PEPPER=
AQUAMONITOR_DB_SCHEMA_READY=false
AQUAMONITOR_DB_SSLMODE=verify-full
# Ruta real a un paquete CA de confianza disponible en el entorno de ejecución.
# En Vercel/Linux comprueba la ruta del sistema antes de configurarla.
AQUAMONITOR_DB_SSLROOTCERT=
# AQUAMONITOR_API_KEY ya no se utiliza ni se acepta.

# ID interno de la asignaci?n autorizada para lectura p?blica. Vac?o deshabilita el feed.
AQUAMONITOR_PUBLIC_ASSIGNMENT_ID=
